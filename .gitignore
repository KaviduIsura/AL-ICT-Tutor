# ==============================================================================
# Sinhala A/L ICT AI Tutor — Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Python & Backend (FastAPI, pytest, virtualenvs)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Type Checking & Linting
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & Frontend (React, Vite, TypeScript)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
jspm_packages/
.pnp
.pnp.js

# Build Outputs
frontend/dist/
frontend/dist-ssr/
frontend/build/
*.tsbuildinfo

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js / Vite Cache
.vite/
frontend/.vite/

# ------------------------------------------------------------------------------
# Operating System & IDE
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# ------------------------------------------------------------------------------
# Uploads, Temporary Files & Data Cache
# ------------------------------------------------------------------------------
uploads/
backend/uploads/
/data/
!frontend/src/data/
*.tmp
*.temp
temp/
*.log
